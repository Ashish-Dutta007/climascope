# Host path containing the canonical tiles_125mm_* directories.
APGB_SOURCE_DIR=/mnt/shared/datasets/spatial/apgb_getmapping

# Keep loopback-only unless an administrator has configured a protected proxy.
APGB_BIND_ADDRESS=127.0.0.1
APGB_GEOSERVER_PORT=8181

# Used in GeoServer-generated capabilities documents. This local value works
# through the documented SSH tunnel. Change only when the HTTPS proxy exists.
APGB_PUBLIC_URL=http://127.0.0.1:8181/apgb

# JVM sizing for the imagery catalogue and concurrent map rendering.
APGB_JAVA_MIN_HEAP=1g
APGB_JAVA_MAX_HEAP=4g

# On-demand cache ceiling. The cache lives in a Docker named volume on retina.
APGB_CACHE_GIB=50
